# Only needed for live paths. Never commit a real .env.
# NEAR AI Cloud private inference (https://cloud.near.ai) — used by AI blocks and `npm run live-check`
NEAR_AI_API_KEY=
# NEAR Intents 1Click partner key (https://partners.near-intents.org), sent as X-API-Key — optional:
# lowers fees; required by 1Click for confidential quotes. Legacy: ONECLICK_JWT (Bearer).
ONECLICK_API_KEY=
# Runner mode: local-dev (default) or dstack (inside a TDX CVM)
TEE_MODE=local-dev
# Set to 0 to disable the local sim traders
SRS_BOTS=1
