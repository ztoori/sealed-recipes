  "kind": "part-catalog",
  "types": {
    "near.account": {
      "description": "NEAR account id (named or implicit)",
      "extends": null
    },
    "address.near": {
      "description": "Any NEAR recipient address",
      "extends": null
    },
    "address.near.fresh": {
      "description": "NEAR address proven to have no on-chain history",
      "extends": "address.near"
    },
    "asset.id": {
      "description": "NEAR Intents asset id from 1Click /v0/tokens (e.g. nep141:wrap.near)",
      "extends": null
    },
    "usd": {
      "description": "USD amount (decimal number)",
      "extends": null
    },
    "token.holdings": {
      "description": "List of {assetId, symbol, contract, amount, decimals, usd}",
      "extends": null
    },
    "token.flags": {
      "description": "List of {assetId, verdict, reason} produced by a guard",
      "extends": null
    },
    "swap.plan": {
      "description": "Ordered 1Click quotes with deposit addresses",
      "extends": null
    },
    "swap.receipts": {
      "description": "Final 1Click statuses with tx hashes",
      "extends": null
    },
    "report": {
      "description": "Human-readable summary object",
      "extends": null
    },
    "percent": {
      "description": "Percentage between 0 and 100 (decimal number)",
      "extends": null
    },
    "key.list": {
      "description": "Access keys of an account: {public_key, kind: full|function-call, receiver, methods, allowance, nonce, action?, reason?}",
      "extends": null
    },
    "stake.list": {
      "description": "Delegations to staking pools: {pool, staked, unstaked, can_withdraw, fee_pct, active}",
      "extends": null
    },
    "contract.facts": {
      "description": "What a contract account exposes on-chain: existence, code, full-access keys, NEP-330 source metadata, token listing",
      "extends": null
    },
    "contract.verdict": {
      "description": "Risk verdict on a contract: {risk: low|medium|high, reasons[], source}",
      "extends": null
    }
  },
