  ],
  "disclosure_rules": {
    "layers": "model, instructions, harness, verification: each open (published), sealed (escrowed to the TEE runner, so it can be rebuilt without anyone seeing it) or closed (held only by the supplier)",
    "runtime": "bundled (code ships inside the attested runner image, pinned by hash) or remote (the supplier operates it as a service)",
    "withdrawal_risk": {
      "high": "closed model, or a remote part with a closed harness or verification",
      "medium": "remote part whose layers are all open or sealed",
      "low": "bundled part with no model or an open-weights model"
    }
  }
