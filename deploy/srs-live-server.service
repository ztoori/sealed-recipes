# Live marketplace on NEAR testnet (server/src/live.ts): reads the deployed contract over RPC, relays the runner's
# signed reports with the relayer key, stores sealed recipes and checkpoints in /var/lib/srs-live/store.
#   sudo cp deploy/srs-live-server.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now srs-live-server
[Unit]
Description=Sealed Recipes live marketplace (testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=srs
Group=srs
WorkingDirectory=/opt/srs-live
EnvironmentFile=/etc/srs/live.env
EnvironmentFile=/etc/srs/secrets.env
Environment=NODE_ENV=production
Environment=PORT=8081
# RUNNER_ID and RUNNER_URL (the TDX runner on Phala Cloud) come from /etc/srs/live.env
# the relayer signs with a function-call key: report_run and checkpoint_run on the contract only
Environment=NEAR_RELAYER_KEY_FILE=/etc/srs/relayer-fc.json
# near-cli key files don't name their account
Environment=NEAR_RELAYER_ACCOUNT=relayer.sealedrecipes.testnet
# the guest faucet (POST /api/faucet) is on when this key file exists; it signs NEAR transfers and tUSDC mints only
Environment=NEAR_FAUCET_KEY_FILE=/etc/srs/faucet.json
Environment=NEAR_FAUCET_ACCOUNT=faucet.sealedrecipes.testnet
Environment=SRS_STORE_DIR=/var/lib/srs-live/store
ExecStart=/usr/bin/node server/src/live.bundle.mjs
Restart=always
RestartSec=3
StateDirectory=srs-live
StateDirectoryMode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
