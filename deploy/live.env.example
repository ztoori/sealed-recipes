# /etc/srs/live.env: non-secret settings of the live (testnet) services. Secrets go in /etc/srs/secrets.env:
#   RUNNER_TOKEN=<openssl rand -hex 32> (the same value as the CVM's encrypted secret). NEAR_AI_API_KEY and ONECLICK_API_KEY
#   are the runner's: CVM encrypted secrets only, not on this machine.
NEAR_NETWORK=testnet
CONTRACT_ID=market.sealedrecipes.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# guest faucet: per guest account (once), per visitor per day, and in total per day
FAUCET_NEAR=0.2
FAUCET_TUSDC=5
FAUCET_PER_IP_DAY=3
FAUCET_PER_DAY=30
# listings superseded on this runner (they stay on-chain). Listings of other runners (CHEK, SAFE, AUDT, AUDIT: the
# retired local-dev runner) are retired automatically.
SRS_RETIRED_LISTINGS=SAFE2,AUDIT2
# the guided demo, served under /demo on this site (the demo gateway, srs-demo); empty turns /demo off
SRS_DEMO_GATEWAY=http://127.0.0.1:8080
# the runner: the TDX one on Phala Cloud (scripts/testnet/README.md, "Runner in a TEE"). Its port is public through the
# Phala gateway (the marketplace runs outside Phala); job endpoints need RUNNER_TOKEN, checked in constant time.
# RUNNER_URL is required: the CVM's public URL for port 8787 (https, no path). The server refuses to start while it is
# unset or still the placeholder.
RUNNER_ID=tee.sealedrecipes.testnet
#RUNNER_URL=https://<app-id>-8787.<node>.phala.network
# label shown on the site; default: from the runner's attestation
SRS_RUNNER_TEE=Intel TDX (dstack, Phala Cloud)
# PCCS that /api/tee/collateral fetches Intel's collateral from (default: Phala's, as dcap-qvl uses)
#SRS_PCCS_URL=https://pccs.phala.network
