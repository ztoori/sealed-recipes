    { "id": "shield", "block": "ai.spam-shield@1.1.0", "inputs": { "holdings": "scan.holdings" }, "params": { "model": "Qwen/Qwen3-30B-A3B-Instruct-2507", "policy": "Flag SCAM tokens and explain the red flag in under 12 words. Answer JSON only." }, "ui": { "x": 280, "y": 120 } },
    { "id": "report", "block": "report.summary@1.0.0", "inputs": { "flags": "shield.flags", "holdings": "scan.holdings" }, "params": {}, "ui": { "x": 560, "y": 120 } }
  ],
  "output": "report.report",
  "listing": { "price_per_run": "150000", "royalty_bps": 2000, "total_shares": "250000" }
