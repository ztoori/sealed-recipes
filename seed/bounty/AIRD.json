{
  "srs": "1.0",
  "kind": "recipe",
  "meta": {
    "ticker": "AIRD",
    "name": "Airdrop claimer (fresh address)",
    "creator": "dropsmith.testnet",
    "description": "Finds the airdrops a wallet can claim and claims them straight to a fresh address. Built for an open bounty on NEAR AI Agent Market."
  },
  "form": [
    { "id": "wallet", "label": "Wallet", "type": "near.account", "required": true, "placeholder": "bob.testnet" },
