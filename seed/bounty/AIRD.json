  ],
  "nodes": [
    { "id": "fresh", "part": "addr.fresh-check@1.0.0", "inputs": { "recipient": "form.recipient" }, "params": {}, "ui": { "x": 0, "y": 130 } },
    { "id": "claim", "part": "airdrop.claim@1.0.0", "inputs": { "account": "form.wallet", "to": "fresh.fresh" }, "params": {}, "ui": { "x": 260, "y": 130 } }
  ],
  "output": "claim.receipts",
  "listing": {"price_per_run": "350000", "reserve_bps": 1000, "bond": "10000000", "pricing": {"price_floor": "200000", "price_ceiling": "1000000", "target_runs": 1}},
  "implements": "job.airdrop-claim@1.0.0"
